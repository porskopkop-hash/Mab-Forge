-- Resolve remotes safely (retry-friendly)
local function GetRemotes()
    local remotes = ReplicatedStorage:FindFirstChild("Remotes")
    if not remotes then
        remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
    end
    return remotes
end

local function GetRemote(name)
    local remotes = GetRemotes()
    return remotes and remotes:FindFirstChild(name)
end

local MineRemote = nil
local ForgeRemote = nil
local SellRemote = nil
local QuestRemote = nil
local CodeRemote = nil
local RerollRemote = nil

-- Refresh remote references each time we need them
local function RefreshRemotes()
    MineRemote = GetRemote("MineRock")
    ForgeRemote = GetRemote("ForgeItem")
    SellRemote = GetRemote("SellOres")
    QuestRemote = GetRemote("CompleteQuest")
    CodeRemote = GetRemote("RedeemCode")
    RerollRemote = GetRemote("RerollRace")
end

-- Task manager: cancels previous worker before starting a new one
local activeWorkers = {}

local function RunLoop(key, conditionFn, interval, fn)
    if activeWorkers[key] then
        activeWorkers[key] = false
    end
    local worker = true
    activeWorkers[key] = worker
    task.spawn(function()
        while worker and conditionFn() do
            local ok, err = pcall(fn)
            if not ok then
                warn("Loop error [" .. tostring(key) .. "]:", err)
            end
            task.wait(interval)
        end
        if activeWorkers[key] == worker then
            activeWorkers[key] = nil
        end
    end)
end

local function StopLoop(key)
    if activeWorkers[key] then
        activeWorkers[key] = false
        activeWorkers[key] = nil
    end
end

local function GetHRP()
    local char = LocalPlayer.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function SafePivot(part)
    local ok, pivot = pcall(function() return part:GetPivot() end)
    if ok and pivot then
        return pivot
    end
    local cframe = part.CFrame
    return cframe and CFrame.new(cframe.Position) or CFrame.new()
end

--================================================--
-- 1. AUTO MINE ROCK
--================================================--
local selectedWorld = "World 1"
local autoMineEnabled = false

Tabs.Main:AddDropdown("WorldDropdown", {
    Title = "Select World",
    Values = { "World 1", "World 2", "World 3", "World 4" },
    Default = 1,
    Callback = function(Value)
        selectedWorld = Value
    end
})

Tabs.Main:AddToggle("AutoMineToggle", {
    Title = "Auto Mine Rocks",
    Default = false,
    Callback = function(Value)
        autoMineEnabled = Value
        if Value == then
            RunLoop("AutoMine", function() return autoMineEnabled end, 0.5, function()
                RefreshRemotes()
                local worldFolder = workspace:FindFirstChild("Worlds") and workspace.Worlds:FindFirstChild(selectedWorld)
                local oresFolder = worldFolder and worldFolder:FindFirstChild("Ores")
                local hrp = GetHRP()
                if not oresFolder or not hrp then return end

local nearestOre, nearestDist = nil, math.huge
                for _, ore in ipairs(oresFolder:GetChildren()) do
                    local part = ore:FindFirstChild("Hitbox") or (ore:IsA("BasePart") and ore)
                    if part then
                        local dist = (hrp.Position - part.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearestOre = { ore = ore, part = part }
                        end
                    end
                end

if nearestOre and nearestDist > 8 then -- teleport only when far
                    hrp.CFrame = SafePivot(nearestOre.ore) + Vector3.new(0, 3, 0)
                end

if nearestOre and MineRemote then
                    MineRemote:FireServer(nearestOre.ore.Name) -- pass string reference, not Instance
                end
            end)
        else
            StopLoop("AutoMine")
        end
    end
})

