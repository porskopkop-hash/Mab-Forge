})

Tabs.Player:AddToggle("AutoRerollToggle", {
    Title = "Auto Reroll Race",
    Default = false,
    Callback = function(Value)
        autoRerollEnabled = Value
        if Value then
            RunLoop("AutoReroll", function() return autoRerollEnabled end, 1.5, function()
                RefreshRemotes()
                local data = LocalPlayer:FindFirstChild("Data")
                local raceVal = data and data:FindFirstChild("Race")

if raceVal and raceVal.Value == targetRace then
                    autoRerollEnabled = false
                    StopLoop("AutoReroll")
                    if Options and Options.AutoRerollToggle then
                        Options.AutoRerollToggle:SetValue(false)
                    end
                    Fluent:Notify({
                        Title = "Race Found!",
                        Content = "Successfully rolled target race: " .. targetRace,
                        Duration = 8
                    })
                    return
                end

if RerollRemote then
                    RerollRemote:FireServer("RaceReroll")
                end
            end)
        else
            StopLoop("AutoReroll")
        end
    end
})

